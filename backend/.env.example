NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/orbelo
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars
FRONTEND_URL=http://localhost:3000

# Avinode API
AVINODE_API_KEY=your-avinode-api-key
AVINODE_BASE_URL=https://api.avinode.com
AVINODE_MOCK_MODE=true

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Orbelo Charter <noreply@orbelo.com>

# Cloudinary (jet images storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Unsplash (jet images)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Pexels (jet images fallback)
PEXELS_API_KEY=your-pexels-api-key

# Sentry (optional error tracking)
SENTRY_DSN=your-sentry-dsn
